{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fotografia.encolada.v1.json",
  "type": "object",
  "required": ["schemaVersion", "eventId", "eventType", "occurredAt", "sesionId", "grupoId", "trabajoId", "intentoId", "objeto"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "eventId": { "type": "string", "minLength": 1 },
    "eventType": { "const": "fotografia.encolada" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "sesionId": { "type": "string", "minLength": 1 },
    "grupoId": { "type": "string", "minLength": 1 },
    "trabajoId": { "type": "string", "minLength": 1 },
    "intentoId": { "type": "string", "minLength": 1 },
    "objeto": {
      "type": "object",
      "required": ["bucket", "key", "versionId"],
      "properties": {
        "bucket": { "type": "string" }, "key": { "type": "string" }, "versionId": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
